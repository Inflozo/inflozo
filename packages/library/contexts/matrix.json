      "top": "layout"
    },
    "home.hbs": {
      "top": "list"
    },
    "index.hbs": {
      "top": "list"
    },
    "post.hbs": {
      "top": "entry",
      "block": "post"
    },
    "page.hbs": {
      "top": "page-entry",
      "block": "post"
    },
    "custom-{name}.hbs": {
      "top": "entry",
      "block": "post"
