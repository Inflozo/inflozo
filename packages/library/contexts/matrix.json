    "@site.labs": "undocumented (appendix B.1 §6)",
    "@site.site_uuid": "undocumented (appendix B.1 §6)",
    "@site.transistor_portal_enabled": "undocumented (appendix B.1 §6)",
    "@site.transistor_portal_heading": "undocumented (appendix B.1 §6)",
    "@site.transistor_portal_description": "undocumented (appendix B.1 §6)",
    "@site.transistor_portal_button_text": "undocumented (appendix B.1 §6)",
    "@site.transistor_portal_url_template": "undocumented (appendix B.1 §6)",
    "@config.image_sizes": "real but undocumented (appendix B.1 §6, §8 item 3)",
    "@labs": "set by middleware but documented nowhere (appendix B.1 §2)",
    "@setting": "a gscan allow-list artifact that no middleware installs (appendix B.1 §2)"
  },
