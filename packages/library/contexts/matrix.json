      "reading_time": {
        "kind": "number",
        "note": "a helper over the field: it prints Ghost's rounded \"1 min read\" (the API's 0 included, hence includeZero=true), and the WHOLE post's time on a body the visitor may not read; it prints NOTHING only where the visitor was sent no body at all and the field is 0 (`!post.html && !post.reading_time`, @tryghost/helpers; recorded on both majors, MEASUREMENTS §41d and §54)"
      },
      "post_class": {
        "kind": "helper"
      },
      "content": {
        "kind": "helper"
      },
      "comments": {
