  "get": {
    "posts": "post",
    "tags": "tag",
    "authors": "author",
    "tiers": "tier",
    "newsletters": "newsletter"
  },
  "scopes": {
    "layout": {},
    "list": {
      "posts": {
        "kind": "list",
        "of": "post"
      },
      "pagination": {
        "kind": "object",
        "of": "pagination"
      }
    },
    "entry": {
      "post": {
        "kind": "object",
        "of": "post"
      }
    },
    "page-entry": {
      "post": {
        "kind": "object",
        "of": "post"
      },
