        "kind": "object",
        "of": "post"
      }
    },
    "tag-archive": {
      "tag": {
        "kind": "object",
        "of": "tag"
      },
      "posts": {
        "kind": "list",
        "of": "post"
      },
      "pagination": {
        "kind": "object",
        "of": "pagination"
      }
    },
    "author-archive": {
      "author": {
        "kind": "object",
        "of": "author"
      },
      "posts": {
        "kind": "list",
        "of": "post"
      },
      "pagination": {
        "kind": "object",
        "of": "pagination"
      }
    },
    "error": {
      "statusCode": {
        "kind": "helper",
        "note": "Ghost hands error.hbs statusCode and message as data, not as helpers; the vocabulary reads both through data-helper (BARE_HELPERS), so they are typed helper here and a data-bind on either is refused toward data-helper."
      },
      "message": {
        "kind": "helper",
        "note": "see statusCode"
      },
      "errorDetails": {
        "kind": "list",
        "of": "errorDetail",
        "unverified": "Ghost fills errorDetails only for a theme-validation error, which no request to a working site can produce — read in both releases: error.hbs is handed `errorDetails: err.errorDetails || []` (core/frontend/web/middleware/error-handler.js:51 in 5.130.6, :89 in 6.58.0), the rule/failures shape is what Ghost's own error view iterates (core/server/views/error.hbs:30-40, both), and the error that carries gscan's results is the theme validator's (core/server/services/themes/validate.js:147 · :151)"
      }
    },
    "private": {
      "error": {
        "kind": "object",
        "of": "private-error"
      }
    },
