  "neverOffer": {
    "@site.codeinjection_head": "raw code — the site's header injection is markup and script, never words, and NFR-3 keeps codeinjection_* out of the canvas, so printing it would break FR-H5's canvas–site agreement (appendix B.1 §6)",
    "@site.codeinjection_foot": "raw code — the site's footer injection is markup and script, never words, and NFR-3 keeps codeinjection_* out of the canvas, so printing it would break FR-H5's canvas–site agreement (appendix B.1 §6)",
    "@site.lang": "an undocumented alias of @site.locale (appendix B.1 §6) — bind @site.locale",
    "@site.members_signup_access": "undocumented (appendix B.1 §6)",
    "@site.portal_default_plan": "undocumented (appendix B.1 §6)",
    "@site.outbound_link_tagging": "undocumented (appendix B.1 §6)",
    "@site.firstpromoter_account": "undocumented (appendix B.1 §6)",
