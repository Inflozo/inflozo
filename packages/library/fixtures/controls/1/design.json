{
  "name": "Controls sample — a feature row",
  "tier": "free",
  "bindingContext": ["none"],
  "compileTarget": ["home.hbs", "index.hbs", "page.hbs"],
  "controlSchema": [
    { "name": "columns", "type": "stepper", "label": "Columns", "group": "layout", "values": ["2", "3", "4"], "default": "3" },
    { "name": "card", "type": "named-select", "label": "Card style", "group": "style", "values": ["flat", "outlined", "raised"], "default": "outlined" },
    { "name": "align", "type": "segmented", "label": "Alignment", "group": "layout", "values": ["start", "center"], "default": "start",
      "valueLabels": { "start": "Left", "center": "Centre" } },
    { "name": "icons", "type": "toggle", "label": "Show icons", "group": "content", "values": ["on", "off"], "default": "on" },
    { "name": "rule", "type": "segmented", "label": "Rule under heading", "group": "style", "values": ["none", "line"], "default": "line",
      "disabledBy": { "control": "align", "whenValue": "center", "inForce": "none", "reason": "Not available while the heading is centred." } },
    { "name": "image", "type": "segmented", "label": "Image position", "group": "layout", "values": ["top", "side"], "default": "top" },
    { "name": "tint", "type": "segmented", "label": "Card tint", "group": "style", "values": ["none", "soft", "strong"], "default": "none", "darkOverride": true }
  ],
  "universals": {
    "bg": { "values": ["base", "surface", "contrast"], "reason": "This design is drawn for plain grounds, so accent and image are not offered." }
  },
  "absent": [
    { "group": "style", "note": "There is no image focus here. This design places your photograph at its own shape, so nothing is cropped and there is nothing for focus to choose." }
  ],
  "dataBindings": {
    "latest": { "source": "posts", "limit": 3, "order": "published_at desc" }
  },
  "ghostCompat": { "minVersion": "5.0.0", "helpers": ["get", "foreach"] },
  "darkCapabilities": ["tokens"],
  "previewSeed": "orbit-weekly",
  "provisional": true,
  "descriptor": {
    "archetype": "feature-row",
    "containment": "cards",
    "ground": "base",
    "itemCount": "few",
    "mediaPlacement": "top",
    "emphasis": "a sample for the controls review page, not a library design"
  }
}
