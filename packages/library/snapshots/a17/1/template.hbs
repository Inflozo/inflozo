<!-- A17 #1 Three Up — Story 4.10's pilot for the paginated context and a `post-card` partial with no params.
     Frame: `A17-1 Three Up.dc.html`; proof: `A17-0 Category Proof.dc.html`; spec: `A17 Post Grids - Spec.md` §0, #1.
     Provisional (AD-35): A17's category story owns the rest of the category. -->
<section class="a17-1" data-per-row="three" data-ratio="landscape" data-excerpt="three" data-meta="photo" data-first-cell="off" data-tag="show" data-bg="base" data-spacing="comfortable" data-divider="none">
  <div class="a17-1__inner">
    <header class="a17-1__head">
      <p class="a17-1__eyebrow">The archive</p>
      <h2 class="a17-1__title">Everything Orbit Weekly published this spring</h2>
      <p class="a17-1__sub">Reporting, field notes and the Thursday letter, in the order they went out.</p>
    </header>
    {{#if posts}}<div class="a17-1__feed">
      <ul class="a17-1__grid">
        {{#foreach posts}}
  {{> "post-card"}}
{{/foreach}}
      </ul>
      <nav class="a17-1__pager" aria-label="{{t "pagination.label"}}">
        {{#if pagination.prev}}<a class="a17-1__newer" href="{{page_url pagination.prev}}"><span class="a17-1__arrow" aria-hidden="true">←</span><span>{{t "pagination.newer"}}</span></a>{{/if}}
        <span class="a17-1__numbers">{{pagination.page}} / {{pagination.pages}}</span>
        {{#if pagination.next}}<a class="a17-1__older" href="{{page_url pagination.next}}"><span>{{t "pagination.older"}}</span><span class="a17-1__arrow" aria-hidden="true">→</span></a>{{/if}}
      </nav>
    </div>{{else}}
    <div class="a17-1__empty">
      <h3 class="a17-1__empty-heading">{{t "archive.empty_heading"}}</h3>
      <p class="a17-1__empty-body">{{t "archive.empty_body"}}</p>
    </div>{{/if}}
    <footer class="a17-1__foot">
      <p class="a17-1__note">Reading times are Ghost's estimate.</p>
    </footer>
  </div>
</section>
