<header class="a1-1" data-on-scroll="shrink" data-nav-position="beside" data-sign-in="on" data-subscribe="on" data-divider-under="hairline" data-nav-before-more="4" data-bg="base" data-spacing="comfortable" data-divider="none">
  <div class="a1-1__bar" data-module="nav-drawer">
    {{#if @site.url}}<a class="a1-1__brand" href="{{@site.url}}">
      {{#if @site.logo}}<img class="a1-1__logo" alt="{{@site.title}}" src="{{@site.logo}}">{{else}}
      {{#if @site.title}}<span class="a1-1__wordmark">{{@site.title}}</span>{{/if}}{{/if}}
    </a>{{/if}}
    <nav class="a1-1__nav" aria-label="{{t "a11y.main_navigation"}}">
      <div class="a1-1__items">{{navigation}}</div>
      <details class="a1-1__more">
        <summary class="a1-1__more-trigger">{{t "nav.more"}}</summary>
        <div class="a1-1__panel">{{navigation}}</div>
      </details>
    </nav>
    <div class="a1-1__actions">
      {{#if @member}}{{#if @member.paid}}{{else}}<a class="a1-1__signin" href="#" data-portal="account">{{t "member.account"}}</a>{{/if}}{{/if}}
      {{#if @member.paid}}<a class="a1-1__signin" href="#" data-portal="account">{{t "member.account"}}</a>{{/if}}
      {{#if @site.allow_self_signup}}<span class="a1-1__ask">
        {{#if @member}}{{else}}<a class="a1-1__signin" href="#" data-portal="signin">{{t "member.signin_cta"}}</a>{{/if}}
        {{#if @member}}{{else}}<a class="a1-1__cta" href="#" data-portal="signup">{{t "member.signup_cta"}}</a>{{/if}}
      </span>{{/if}}
    </div>
    <button class="a1-1__menu" type="button" aria-expanded="false" aria-label="{{t "a11y.open_menu"}}"><span class="a1-1__menu-bar"></span><span class="a1-1__menu-bar"></span></button>
  </div>
</header>
