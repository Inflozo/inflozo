{
  "name": "Centred",
  "tier": "free",
  "bindingContext": ["post"],
  "compileTarget": ["post.hbs"],
  "controlSchema": [
    { "name": "align", "type": "segmented", "label": "Alignment", "group": "arrangement", "values": ["start", "center"], "default": "center",
      "valueLabels": { "start": "Left", "center": "Centre" } },
    { "name": "title-size", "type": "segmented", "label": "Title size", "group": "arrangement", "values": ["small", "medium", "large"], "default": "medium" },
    { "name": "standfirst-lines", "type": "segmented", "label": "Standfirst lines", "group": "arrangement", "values": ["two", "three", "full"], "default": "full",
      "disabledBy": { "control": "standfirst", "whenValue": "off", "inForce": "full", "reason": "Not used while the post's Standfirst is Off." } },
    { "name": "ratio", "type": "named-select", "label": "Image ratio", "group": "arrangement", "values": ["landscape", "wide", "square", "portrait"], "default": "wide",
      "valueLabels": { "landscape": "Landscape 3:2", "wide": "Wide 16:9", "square": "Square 1:1", "portrait": "Portrait 4:5" } },
    { "name": "rule", "type": "segmented", "label": "Rule", "group": "arrangement", "values": ["none", "above", "below"], "default": "none",
      "valueLabels": { "above": "Above the tag", "below": "Below the meta" } },
    { "name": "tag-line", "type": "named-select", "label": "Tag line", "group": "style", "values": ["primary", "off"], "default": "primary",
      "valueLabels": { "primary": "Primary tag" } },
    { "name": "meta", "type": "named-select", "label": "Meta", "group": "style", "values": ["author-date", "author-date-reading", "author", "date", "off"], "default": "author-date-reading",
      "valueLabels": { "author-date": "Author and date", "author-date-reading": "Author, date and reading time", "author": "Author only", "date": "Date only" } },
    { "name": "standfirst", "type": "named-select", "label": "Standfirst", "group": "style", "values": ["excerpt", "off"], "default": "excerpt",
      "valueLabels": { "excerpt": "From the excerpt" } },
    { "name": "feature-image", "type": "named-select", "label": "Feature image", "group": "style", "values": ["post", "off"], "default": "post",
      "valueLabels": { "post": "From the post" } },
    { "name": "avatar", "type": "named-select", "label": "Avatar", "group": "style", "values": ["off", "small", "medium", "large"], "default": "small",
      "valueLabels": { "small": "Small 24", "medium": "Medium 36", "large": "Large 44" } },
    { "name": "caption", "type": "named-select", "label": "Caption", "group": "style", "values": ["ghost", "hide"], "default": "ghost",
      "valueLabels": { "ghost": "From Ghost" } }
  ],
  "universals": {
    "bg": { "values": ["base", "surface", "contrast"], "reason": "This design is drawn for plain grounds, so accent and image are not offered." }
  },
  "ghostCompat": { "minVersion": "5.0.0", "helpers": ["if", "img_url", "date", "excerpt", "t"] },
  "darkCapabilities": ["tokens"],
  "previewSeed": "orbit-weekly",
  "provisional": true,
  "descriptor": {
    "archetype": "stack",
    "containment": "none",
    "ground": "page",
    "itemCount": "one",
    "mediaPlacement": "bottom",
    "emphasis": "centred column"
  }
}
