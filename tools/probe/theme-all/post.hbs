{{!< default}}
{{#post}}
<article class="post">
  <h1>{{title}}</h1>
  <div id="probe-access">ACCESS|access={{access}}|visibility={{visibility}}</div>
  <section class="content">{{content}}</section>
  <div id="probe-comments">
  {{#if @site.comments_enabled}}COMMENTS|enabled={{@site.comments_enabled}}|count={{comment_count}}{{/if}}
  </div>
  <div id="probe-explicit">EXPLICIT_START{{> "content-cta"}}EXPLICIT_END</div>
  {{comments}}
</article>
{{/post}}
