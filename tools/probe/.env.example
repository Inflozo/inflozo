# TEMPLATE. Copy to `.env` and fill in — `.env` is gitignored, this file is NOT.
#
#     cp tools/probe/.env.example tools/probe/.env
#
# Never type a real key into THIS file.
#
# NAMING: the box is named for the Ghost MAJOR it runs, so a probe can never be
# aimed at the wrong site by reading the wrong variable.
#   GHOST5_*  ghost5.inflozo.com  — target T3, self-hosted 5.x, permanent (§4)
#   GHOST6_*  ghost6.inflozo.com  — target T1, self-hosted 6.x
#   TRAVIO_*  ghost.inflozo.com   — NOT a probe target. Commented out on purpose.


# ═══ GHOST 5 — target T3 ═══════════════════════════════════════════ LIVE ═══
# ghost 5.130.6 · gscan 4.49.7 · verified 2026-08-20, matches MEASUREMENTS §13
GHOST5_URL=https://ghost5.inflozo.com
GHOST5_MAJOR=5
GHOST5_ADMIN_API_KEY=
GHOST5_CONTENT_API_KEY=
GHOST5_STAFF_ACCESS_TOKEN=
GHOST5_STRIPE_TEST_CONNECTED=
GHOST5_IS_DISPOSABLE=yes

# provisioning — used by tools/probe/provision-ghost5.sh
GHOST5_HOST=
GHOST5_MYSQL_ROOT_PW=
GHOST5_SSL_EMAIL=
GHOST5_VERSION=5.130.6
GHOST5_GSCAN_EXPECTED=4.49.7


# ═══ GHOST 6 — target T1 ══════════════════════════════════ AWAITING DROPLET ═══
# I pin 6.58.0 because it bundles gscan 6.4.2 — the exact pair MEASUREMENTS §13
# measured, so both halves of AD-34's pairing stay comparable.
GHOST6_URL=https://ghost6.inflozo.com
GHOST6_MAJOR=6
GHOST6_ADMIN_API_KEY=
GHOST6_CONTENT_API_KEY=
GHOST6_STAFF_ACCESS_TOKEN=
GHOST6_STRIPE_TEST_CONNECTED=
GHOST6_IS_DISPOSABLE=yes

GHOST6_HOST=
GHOST6_MYSQL_ROOT_PW=
GHOST6_SSL_EMAIL=
GHOST6_VERSION=6.58.0
GHOST6_GSCAN_EXPECTED=6.4.2


# ═══ TRAVIO — NOT A PROBE TARGET ═════════════════════════════════════════════
# The pre-existing 512 MB Ghost 6 at ghost.inflozo.com, title "Travio", with
# members enabled and Stripe connected. Deliberately commented out: the probes
# upload AND ACTIVATE themes, and if this is a real publication that changes what
# its visitors see. Uncomment only if you confirm it is scratch.
# TRAVIO_URL=
# TRAVIO_ADMIN_API_KEY=
# TRAVIO_CONTENT_API_KEY=
# TRAVIO_STAFF_ACCESS_TOKEN=


# ═══ GHOST(PRO) — ⛔ the launch gate. Fill this ONLY when the trial starts. ═══
# VERIFY items 1 and 2 are the only two on the register that block PUBLIC LAUNCH
# rather than an epic. The trial is 14 days; tools/probe/run-verify-ghostpro.py is
# already written so the gate is one command, not a week of work against a clock.
GHOSTPRO_URL=
GHOSTPRO_ADMIN_API_KEY=
GHOSTPRO_CONTENT_API_KEY=
GHOSTPRO_STAFF_ACCESS_TOKEN=
GHOSTPRO_PLAN=                  # starter | creator | team | business


# ═══ SUPABASE — new project.  NEW-STYLE KEYS ONLY. ══════════════════════════════════════════════════
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
SUPABASE_PROJECT_CREATED=

# the OLD project — READ-ONLY. Only to read the real pre-cutover grant state
# before Supabase's 2026-10-30 enforcement. Nothing is written to it.
SUPABASE_OLD_DB_URL=


# ═══ VERCEL — new project, Pro plan ══════════════════════════════════════════
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT=inflozo-probe
VERCEL_PLAN=


# ═══ RESEND ══════════════════════════════════════════════════════════════════
# onboarding@resend.dev sends to your own account address with no DNS setup —
# enough to prove the Supabase Auth SMTP path, which is the actual risk.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
RESEND_TEST_INBOX=


# ═══ DODO — optional, test mode ══════════════════════════════════════════════
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
