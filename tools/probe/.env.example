# ─────────────────────────────────────────────────────────────────────────────
# Inflozo — probe environment.  Copy to `.env` and fill in.  `.env` is gitignored.
#
#     cp tools/probe/.env.example tools/probe/.env
#
# Nothing here is needed all at once. Each block is independent and each names
# the VERIFY-AT-BUILD items and findings it unlocks, so a half-filled file still
# runs the half it can. Fill GHOST first — it closes the most.
#
# ⚠️  EVERY TARGET MUST BE DISPOSABLE. These probes upload and ACTIVATE themes,
#     change site settings, create members and tiers, apply schema, and (for one
#     named test) attempt a TRUNCATE. Do not point any of them at a live site,
#     a real customer's Ghost, or a Supabase project holding data you want.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. GHOST  —  highest value: closes 13 VERIFY-AT-BUILD items, 2 of them blocking
# ═════════════════════════════════════════════════════════════════════════════
# Unlocks: item 13 (@even/@odd parity — BLOCKS E9) · item 11 (content-cta.hbs
# paywall override — the costliest refutation left) · item 15 ({{comments}} —
# BLOCKS E10's A28) · items 3, 8, 9, 10, 12, 14c, 14d, 18, 20, 21 · and the
# end-to-end proof of Round 3's F1 (hostile user text on a live rendered page).

# The site's public URL, no trailing slash.  e.g. https://probe.example.com
GHOST_URL=

# Ghost version you installed — "5" or "6". Round 2 proved the majors diverge and
# NFR-7 supports both, so tell me which this is; I'll run the other major in
# Docker locally. The real box is what proves HOST-level facts (upload caps,
# nginx body limits) that Docker cannot.
GHOST_MAJOR=

# Admin API key.  Ghost Admin → Settings → Integrations → Add custom integration.
# Copy the "Admin API key" verbatim — it is TWO parts joined by a colon, id:secret.
GHOST_ADMIN_API_KEY=

# Content API key, from the same integration screen. Not a secret by design (AD-10).
GHOST_CONTENT_API_KEY=

# OPTIONAL — only for VERIFY item 9 ("does the Owner's Staff Access Token lift
# GET /themes/?"). Ghost Admin → your avatar → Profile → scroll to Staff Access
# Token. Leave blank to skip that one item; nothing else needs it.
GHOST_STAFF_ACCESS_TOKEN=

# OPTIONAL — a second Ghost of the OTHER major, if you have one. Round 2 found
# real behavioural divergence between 5.130.6 and 6.58.0, so a second real box
# turns every Ghost finding below into a per-major answer instead of a single one.
GHOST2_URL=
GHOST2_MAJOR=
GHOST2_ADMIN_API_KEY=
GHOST2_CONTENT_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# 2. SUPABASE  —  a FRESH, EMPTY project. Not one holding anything.
# ═════════════════════════════════════════════════════════════════════════════
# Unlocks: E1's exit criterion against real hosted Postgres rather than local
# (R2-1's grant cutover, 36 assertions) · VERIFY item 4 (passkey API usability)
# · VERIFY 29 confirmed on HOSTED rather than the storage-api image · Round 3's
# F3 (is `storage` reachable through PostgREST there?) and F8 (can a browser
# client PUT an unsanitized SVG straight to assets/{userId}/?).

# Project URL.  Dashboard → Project Settings → API.  e.g. https://abcd.supabase.co
SUPABASE_URL=

# anon / publishable key — the browser key. Same screen.
SUPABASE_ANON_KEY=

# service_role key — SECRET. Same screen, "reveal". Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, for psql.  Dashboard → Connect → Session
# pooler or Direct connection.  postgresql://postgres.<ref>:<pw>@<host>:5432/postgres
SUPABASE_DB_URL=

# Was this project created AFTER 2026-05-30? "yes" / "no".  It decides whether
# the project already has Supabase's new no-automatic-grants default, which is
# the thing R2-1 rewrote SCHEMA.sql for. If "no", the enforced cutover is
# 2026-10-30 and I test both states.
SUPABASE_NEW_GRANT_DEFAULT=


# ═════════════════════════════════════════════════════════════════════════════
# 3. VERCEL  —  a NEW throwaway project, on the Pro plan
# ═════════════════════════════════════════════════════════════════════════════
# Unlocks: R1 decision 11 (Fluid shares ONE instance across concurrent
# invocations — the claim AD-11's whole memory budget rests on) · R1 decision 5
# (nonce + strict-dynamic CSP vs SSG, deferred three rounds) · AD-13's 4.5 MB
# request/response cap · the proxy.ts-on-Node-runtime rename.
#
# Pro matters: AD-11 sizes against the PRO defaults (300 s / 2048 MB). On Hobby
# the numbers mean nothing and Fluid behaves differently.

# Token: vercel.com → Settings → Tokens → Create. SCOPE IT to one new project if
# the UI lets you; otherwise create it, let me run, then delete it afterwards.
VERCEL_TOKEN=

# Team/org slug or ID, if the project lives under a team rather than your
# personal account. Blank for personal.
VERCEL_TEAM_ID=

# Name for the throwaway project I should create/deploy to. Suggest: inflozo-probe
VERCEL_PROJECT=inflozo-probe

# Confirm the plan — "pro" or "hobby". If hobby, I run the tests that still mean
# something and say plainly which ones I skipped.
VERCEL_PLAN=


# ═════════════════════════════════════════════════════════════════════════════
# NOT NEEDED — stated so you don't hand over more than the tests require
# ═════════════════════════════════════════════════════════════════════════════
# · No DigitalOcean API token. I reach Ghost over its own HTTP API; I never need
#   to touch the droplet. (If you WANT the droplet's theme-upload nginx limit
#   measured directly, SSH is the only way — but the API probe infers it.)
# · No Dodo Payments keys. Nothing outstanding needs them; billing is E12 and
#   its open items are fee-schedule reading, not execution.
# · No Resend key. Same reason.
# · No domain or DNS access.
