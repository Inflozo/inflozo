# ─────────────────────────────────────────────────────────────────────────────
# Inflozo — probe environment.  Copy to `.env` and fill in.  `.env` is gitignored.
#
#     cp tools/probe/.env.example tools/probe/.env
#
# Each block is independent and names what it unlocks, so a half-filled file
# still runs the half it can. Fill GHOST first — it closes the most.
#
# ⚠️  TWO OF THESE ARE EXISTING PROJECTS THAT NEED CLEARING. Nothing is cleared
#     without the protocol in RESET-PROTOCOL.md: I inventory first, show you what
#     is there, and wait for your explicit go-ahead. Clearing is irreversible.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. GHOST  —  closes 13 VERIFY-AT-BUILD items, 2 of them blocking epics
# ═════════════════════════════════════════════════════════════════════════════
# Item 13 (@even/@odd parity — BLOCKS E9) · item 11 (content-cta.hbs paywall
# override) · item 15 ({{comments}} — BLOCKS E10's A28) · items 3, 8, 9, 10, 12,
# 14c, 14d, 18, 20, 21 · plus the live-page proof of Round 3's F1.

GHOST_URL=                      # https://probe.example.com — no trailing slash
GHOST_MAJOR=                    # "5" or "6" — the majors diverge, I need to know which
GHOST_ADMIN_API_KEY=            # Settings → Integrations → Add custom integration. id:secret
GHOST_CONTENT_API_KEY=          # same screen. Not a secret by design (AD-10)
GHOST_STAFF_ACCESS_TOKEN=       # OPTIONAL — only VERIFY item 9. Profile → Staff Access Token
GHOST_STRIPE_TEST_CONNECTED=    # "yes"/"no" — decides whether paid-tier probes are real or degraded
GHOST_IS_DISPOSABLE=            # "yes" required. Probes upload AND ACTIVATE themes.

# A SECOND Ghost of the other major turns every finding below into a per-major
# answer. NFR-7 supports both and T3 is a permanent 5.x target.
GHOST2_URL=
GHOST2_MAJOR=
GHOST2_ADMIN_API_KEY=
GHOST2_CONTENT_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# 2. SUPABASE  —  EXISTING project. See RESET-PROTOCOL.md before anything runs.
# ═════════════════════════════════════════════════════════════════════════════
# E1's exit criterion against real hosted Postgres · VERIFY item 4 (passkeys)
# · VERIFY 29 confirmed on hosted · Round 3 F3 (is `storage` PostgREST-exposed?)
# and F8 (can a browser client PUT an unsanitized SVG to assets/{userId}/?)
# · D6's open probe: can hosted `postgres` actually perform the TRUNCATE revoke?

SUPABASE_URL=                   # Project Settings → API
SUPABASE_ANON_KEY=              # publishable / anon key
SUPABASE_SERVICE_ROLE_KEY=      # SECRET — reveal on the same screen
SUPABASE_DB_URL=                # Connect → Direct connection, WITH the password.
                                # postgresql://postgres.<ref>:<pw>@<host>:5432/postgres
                                # Without this I cannot apply SCHEMA.sql or run RLS-TEST.sql.
SUPABASE_PROJECT_CREATED=       # rough date. Before 2026-05-30 = the OLD grant default,
                                # which is GOOD: it lets me test R2-1 against both states
                                # and rehearse the 2026-10-30 enforced cutover.
SUPABASE_OK_TO_WIPE=            # leave BLANK. I fill this in with you after the inventory.


# ═════════════════════════════════════════════════════════════════════════════
# 3. VERCEL  —  a NEW project, please. Reasons in RESET-PROTOCOL.md.
# ═════════════════════════════════════════════════════════════════════════════
# R1 decision 11 (Fluid shares ONE instance across concurrent invocations — the
# claim AD-11's memory budget rests on) · R1 decision 5 (nonce + strict-dynamic
# CSP vs SSG, deferred three rounds) · AD-13's 4.5 MB body cap · proxy.ts on Node.

VERCEL_TOKEN=                   # vercel.com → Settings → Tokens. Scope to one project if offered.
VERCEL_TEAM_ID=                 # blank for a personal account
VERCEL_PROJECT=inflozo-probe    # I create this. Say so here if you want an existing one reused.
VERCEL_PLAN=                    # "pro" or "hobby". AD-11's numbers only mean something on Pro.
VERCEL_FLUID_ENABLED=           # "yes"/"no" — project-wide, and R1 d11's whole subject


# ═════════════════════════════════════════════════════════════════════════════
# 4. RESEND  —  the one integration nothing has ever exercised
# ═════════════════════════════════════════════════════════════════════════════
# FR-P1's five transactional emails, and — the real risk — Supabase Auth SMTP
# routed through Resend, which is how magic links get delivered. E1 and E2 both
# depend on that path and no round has sent a single message through it.

RESEND_API_KEY=                 # resend.com → API Keys
RESEND_FROM=                    # e.g. probe@inflozo.com — the DOMAIN MUST BE VERIFIED
                                # in Resend first (DNS records). I cannot do that step.
RESEND_TEST_INBOX=              # an address you can actually read, for delivery confirmation


# ═════════════════════════════════════════════════════════════════════════════
# 5. DODO  —  optional, test mode. Only if you already have an account.
# ═════════════════════════════════════════════════════════════════════════════
# VERIFY item 5 (fee schedule → Appendix F's break-evens) and item 6 (the event
# catalog, and whether Dodo sends the annual renewal notice as merchant of
# record — statutory in several target markets, and it decides whether FR-P1
# grows a sixth email). E12 is far off, but item 6 is a legal question with a
# build consequence, so it is worth capturing early.

DODO_API_KEY=                   # test mode
DODO_WEBHOOK_SECRET=


# ═════════════════════════════════════════════════════════════════════════════
# NOT NEEDED — so you hand over no more than the tests require
# ═════════════════════════════════════════════════════════════════════════════
# · No DigitalOcean token. I reach Ghost over its own HTTP API.
# · No Ghost(Pro) Starter trial. VERIFY items 1–2 need one, but it is time-boxed
#   and the register's own trigger is "when E13 closes and E14 opens, not before".
#   Buying it now means buying it twice. Deliberately skipped.
# · No domain or DNS access beyond whatever Resend verification you do yourself.
