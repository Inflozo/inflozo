{{!< default}}
{{#tag}}
<pre id="probe">
TAG|name=[{{name}}]
TAG|slug=[{{slug}}]
TAG|description=[{{description}}]
TAG|url=[{{url}}]
TAG|accent_color=[{{accent_color}}]
TAG|feature_image=[{{feature_image}}]
TAG|visibility=[{{visibility}}]
PAGE|pagination_page=[{{../pagination.page}}]
PAGE|pagination_pages=[{{../pagination.pages}}]
PAGE|posts_on_page=[{{../posts.length}}]
</pre>
{{/tag}}
