{{!< default}}
{{!--
  AD-23's recording surface, template one: everything FR-H5 lists that is reachable WITHOUT a post,
  a tag, an author or an error. `record-shim.py` reads the block below back and writes it to
  packages/ghost-shim/fixtures/. The two placeholders it substitutes before zipping are
  __IMG_URL_BLOCK__ (one line per FR-J2 image_sizes KEY, derived from the library's one copy) and
  __UPLOADED__ (the Ghost-hosted image the recorder uploads — every seeded feature image is an
  external static.ghost.org URL that no Ghost will ever resize, so nothing already on the box can
  exercise a rendition).
  Story 4.9 adds `locales/en.json` and the TR group: `{{t}}`'s lookup, params and escaping on both majors.
  Story 4.10 adds the PILOT group: a no-param partial in a loop (`partials/probe-card.hbs`), the navigation
  loop's fields, the signed-out `@member.paid` arm, the logo and self-signup conditions, and a one-post `{{#get}}`.
  Story 5.19 adds the FEED group, each row under this page's full native feed: a `{{#get}}` with and without
  `include`, the shadowing premise at zero and with rows, the three Source filters (the writer's in both spellings:
  `author:` answers, and gscan refuses it — the fold writes `authors:`), hand-picked ids in a chosen
  order (__FEED_IDS__ / __FEED_PICKS__, substituted at zip time from the site's own posts) and `pagination` inside a get.
--}}
<pre id="probe">
SITE|title=[{{@site.title}}]
SITE|url=[{{@site.url}}]
SITE|description=[{{@site.description}}]
SITE|logo=[{{@site.logo}}]
SITE|icon=[{{@site.icon}}]
SITE|cover_image=[{{@site.cover_image}}]
SITE|accent_color=[{{@site.accent_color}}]
SITE|locale=[{{@site.locale}}]
SITE|timezone=[{{@site.timezone}}]
SITE|posts_per_page=[{{@config.posts_per_page}}]

CORE|total_members=[{{total_members}}]
CORE|total_paid_members=[{{total_paid_members}}]
CORE|content_api_url=[{{content_api_url}}]
CORE|content_api_key=[{{content_api_key}}]

ASSET|screen_css=[{{asset "css/screen.css"}}]
ASSET|no_such=[{{asset "css/nope.css"}}]

TEXT|t_unknown=[{{t "Older posts"}}]

TR|plain_control=[{{t "Plain key"}}]
TR|dotted_hit=[{{t "probe.dotted_hit"}}]
TR|nested_miss=[{{t "probe.nested_miss"}}]
TR|missing_key=[{{t "probe.no_such_key"}}]
TR|params_path=[{{t "probe.page_of" page=pagination.page pages=pagination.pages}}]
TR|param_undefined=[{{t "probe.page_of" page=pagination.page pages=no_such_field}}]
TR|param_omitted=[{{t "probe.page_of" page=pagination.page}}]
TR|escape_text=[{{t "probe.escape"}}]
TEXT|encode=[{{encode "a b&c"}}]

MEMBER|if_member=[{{#if @member}}SIGNED_IN{{else}}ANONYMOUS{{/if}}]
MEMBER|paid_enabled=[{{@site.paid_members_enabled}}]
MEMBER|allow_self_signup=[{{@site.allow_self_signup}}]

PILOT|partial_noparam=[{{#foreach posts limit="2"}}{{> "probe-card"}}{{/foreach}}]
PILOT|nav_items=[{{#foreach @site.navigation}}{{label}}={{url}};{{/foreach}}]
PILOT|if_member_paid=[{{#if @member.paid}}PAID{{else}}NOT_PAID{{/if}}]
PILOT|if_logo=[{{#if @site.logo}}LOGO{{else}}NO_LOGO{{/if}}]
PILOT|if_self_signup=[{{#if @site.allow_self_signup}}ASK{{/if}}]
PILOT|get_latest=[{{#get "posts" limit="1" order="published_at desc"}}{{#foreach posts}}{{title}}{{/foreach}}{{/get}}]

FEED|native=[{{posts.length}}|{{pagination.page}}/{{pagination.pages}}|{{pagination.next}}]
FEED|get_plain=[{{#get "posts" limit="3" order="published_at desc"}}{{#foreach posts}}{{title}}|{{primary_tag.name}}|{{primary_author.name}};{{/foreach}}{{/get}}]
FEED|get_include=[{{#get "posts" limit="3" order="published_at desc" include="tags,authors"}}{{#foreach posts}}{{title}}|{{primary_tag.name}}|{{primary_author.name}};{{/foreach}}{{/get}}]
FEED|shadow_zero=[{{#get "posts" filter="tag:'inflozo-probe-no-such-tag'" limit="3"}}{{#if posts}}FULL:{{posts.length}}{{else}}EMPTY{{/if}}{{else}}GET_ELSE{{/get}}]
FEED|shadow_rows=[{{#get "posts" filter="tag:'craft'" limit="2"}}{{#if posts}}FULL:{{posts.length}}{{else}}EMPTY{{/if}}{{/get}}]
FEED|by_tag=[{{#get "posts" filter="tag:'craft'" order="published_at asc" limit="3"}}{{#foreach posts}}{{slug}},{{/foreach}}{{/get}}]
FEED|by_author=[{{#get "posts" filter="author:'priya-raman'" order="published_at asc" limit="3"}}{{#foreach posts}}{{slug}},{{/foreach}}{{/get}}]
FEED|by_authors=[{{#get "posts" filter="authors:'priya-raman'" order="published_at asc" limit="3"}}{{#foreach posts}}{{slug}},{{/foreach}}{{/get}}]
FEED|featured=[{{#get "posts" filter="featured:true" order="published_at asc" limit="3"}}{{#foreach posts}}{{slug}},{{/foreach}}{{/get}}]
FEED|picks_single=[__FEED_PICKS__]
FEED|picks_existence=[{{#get "posts" filter="id:[__FEED_IDS__]" limit="1"}}{{#if posts}}__FEED_PICKS__{{else}}EMPTY{{/if}}{{/get}}]
FEED|picks_none=[{{#get "posts" filter="id:[000000000000000000000000]" limit="1"}}{{#if posts}}FULL{{else}}EMPTY{{/if}}{{/get}}]
FEED|pagination_in_get=[{{#get "posts" filter="tag:'craft'" limit="2"}}{{pagination.page}}/{{pagination.pages}}|{{pagination.next}}|{{#if pagination.next}}{{page_url pagination.next}}{{/if}}{{/get}}]

MATCH|locale_true=[{{#match @site.locale @site.locale}}YES{{else}}NO{{/match}}]
MATCH|locale_false=[{{#match @site.locale "zz-ZZ"}}YES{{else}}NO{{/match}}]
MATCH|op_gt=[{{#match @config.posts_per_page ">" 1}}YES{{else}}NO{{/match}}]

TRUTHY|is_index=[{{#is "index"}}YES{{else}}NO{{/is}}]
TRUTHY|is_post=[{{#is "post"}}YES{{else}}NO{{/is}}]
TRUTHY|has_slug_home=[{{#has slug="home"}}YES{{else}}NO{{/has}}]

PAGE|pagination_page=[{{pagination.page}}]
PAGE|pagination_pages=[{{pagination.pages}}]
PAGE|pagination_limit=[{{pagination.limit}}]
PAGE|pagination_total=[{{pagination.total}}]
PAGE|pagination_next=[{{pagination.next}}]
PAGE|pagination_prev=[{{pagination.prev}}]
PAGE|page_url_next=[{{#if pagination.next}}{{page_url pagination.next}}{{/if}}]
PAGE|page_url_prev=[{{#if pagination.prev}}{{page_url pagination.prev}}{{/if}}]
PAGE|posts_on_page=[{{posts.length}}]

__IMG_URL_BLOCK__

GET|filter=[tag:craft+featured:true]
GET|craft_featured=[{{#get "posts" filter="tag:craft+featured:true" limit="3" order="published_at desc"}}{{#foreach posts}}{{slug}},{{/foreach}}{{else}}BLOCK_DID_NOT_RUN{{/get}}]
GET|tags_visible=[{{#get "tags" filter="visibility:public" limit="4" order="name asc"}}{{#foreach tags}}{{slug}},{{/foreach}}{{/get}}]
GET|authors=[{{#get "authors" limit="3" order="name asc"}}{{#foreach authors}}{{slug}},{{/foreach}}{{/get}}]
GET|tiers=[{{#get "tiers" filter="type:paid+visibility:public" limit="5"}}{{#foreach tiers}}{{slug}},{{/foreach}}{{else}}NO_ROWS{{/get}}]
GET|ids_one=[{{#get "posts" limit="1"}}{{#foreach posts}}{{id}}{{/foreach}}{{/get}}]
</pre>
<pre id="raw-navigation">{{navigation}}</pre>
<pre id="raw-navigation-secondary">{{navigation type="secondary"}}</pre>
<pre id="raw-nav-items">{{#foreach @site.navigation}}NAV|label=[{{this.label}}]|url=[{{this.url}}]|current=[{{this.current}}]
{{/foreach}}</pre>
<pre id="raw-nav-items-secondary">{{#foreach @site.secondary_navigation}}NAV|label=[{{this.label}}]|url=[{{this.url}}]|current=[{{this.current}}]
{{/foreach}}</pre>
<pre id="raw-pagination">{{pagination}}</pre>
{{!-- Story 4.9: read back WITHOUT unescaping, because what Ghost escapes is the fact recorded --}}
<pre id="verbatim-t-escape-text">{{t "probe.escape"}}</pre>
<pre id="verbatim-t-escape-attr"><i title="{{t "probe.escape"}}"></i></pre>
<pre id="verbatim-t-param-html">{{t "probe.by" author="<b>A&B</b>"}}</pre>
<pre id="verbatim-t-plural">{{plural pagination.total empty=(t "probe.posts_none") singular=(t "probe.posts_one") plural=(t "probe.posts_many")}}</pre>
