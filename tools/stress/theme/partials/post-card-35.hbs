<article class="card">
      <a class="card__img-link" href="{{url}}">
        {{#if feature_image}}<img class="card__img" src="{{img_url feature_image size="m"}}" alt="">{{/if}}
      </a>
      <div class="card__body">
        <ul class="card__tags">
          {{#foreach tags limit="3"}}
<li class="card__tag">
            <a class="card__tag-link" href="{{url}}"><span>{{name}}</span></a>
          </li>
{{/foreach}}
        </ul>
        <h3 class="card__title">{{title}}</h3>
        {{#if excerpt}}<p class="card__excerpt">{{excerpt}}</p>{{/if}}
        <footer class="card__meta">
          {{#if primary_author.profile_image}}<img class="card__avatar" src="{{img_url primary_author.profile_image size="s"}}" alt="">{{/if}}
          <span class="card__author">{{primary_author.name}}</span>
          <time class="card__date">{{date published_at format="D MMM YYYY"}}</time>
          <span class="card__read">{{reading_time}}</span>
        </footer>
      </div>
    </article>
