{{!-- content-23 --}}
<section class="d-a25-23 article" data-bg="surface" data-spacing="comfortable" data-divider="line" data-measure="normal" data-drop-cap="on" data-links="underline" data-quote="bar" data-figure="wide" data-toc="none">
  <header class="article__head">
    <h1 class="article__title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="article__excerpt">{{custom_excerpt}}</p>{{/if}}
    <div class="article__meta">
      {{#if primary_author.profile_image}}<img class="article__avatar" src="{{img_url primary_author.profile_image size="s"}}" alt="">{{/if}}
      <span class="article__author">{{primary_author.name}}</span>
      <time class="article__date">{{date published_at format="D MMM YYYY"}}</time>
    </div>
    {{#if feature_image}}<img class="article__feature" src="{{img_url feature_image size="l"}}" alt="">{{/if}}
  </header>
  <div class="article__body kg-canvas">{{content}}</div>
  <footer class="article__foot">
    <ul class="article__share">
      <li><a class="article__share-link" href="#sh1" aria-label="Share 1"><svg class="ico ico--1" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M1 2 L22 3 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="4"></circle><rect x="1" y="4" width="6" height="6" rx="1"></rect></svg></a></li>
      <li><a class="article__share-link" href="#sh2" aria-label="Share 2"><svg class="ico ico--2" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M2 2 L22 4 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="5"></circle><rect x="2" y="4" width="6" height="6" rx="1"></rect></svg></a></li>
      <li><a class="article__share-link" href="#sh3" aria-label="Share 3"><svg class="ico ico--3" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M3 2 L22 5 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="6"></circle><rect x="3" y="4" width="6" height="6" rx="1"></rect></svg></a></li>
    </ul>
    <div class="article__bio">
      {{#if primary_author.profile_image}}<img class="article__bio-img" src="{{img_url primary_author.profile_image size="m"}}" alt="">{{/if}}
      <h2 class="article__bio-name">{{primary_author.name}}</h2>
      {{#if primary_author.bio}}<p class="article__bio-text">{{primary_author.bio}}</p>{{/if}}
    </div>
    <section class="article__related">
      <h2 class="article__related-title">More like this</h2>
      <ul class="article__related-list">
        {{#foreach posts limit="3"}}
  {{> "related-23"}}
{{/foreach}}
      </ul>
    </section>
  </footer>
</section>
