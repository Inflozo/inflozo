{{!-- hero-10 --}}
<section class="d-a4-10 hero" data-bg="surface" data-spacing="comfortable" data-divider="line" data-align="start" data-media="right" data-ratio="wide" data-eyebrow="on" data-stats="on" data-overlay="scrim" data-height="tall" data-cta-style="pair" data-text-size="xl" data-rule="none">
  <div class="hero__text">
    <p class="hero__eyebrow">Issue 9</p>
    <h1 class="hero__title">Section 9 headline</h1>
    <p class="hero__sub">A sentence for section 9.</p>
    <div class="hero__ctas">
      <a class="hero__cta button button--primary" href="/start/">Get started</a>
      <a class="hero__cta2 button button--ghost" href="/sample/">Read a sample</a>
    </div>
    <dl class="hero__stats">
      <div class="hero__stat"><dt class="hero__stat-k">Metric 1</dt><dd class="hero__stat-v">12,000</dd></div>
      <div class="hero__stat"><dt class="hero__stat-k">Metric 2</dt><dd class="hero__stat-v">22,000</dd></div>
      <div class="hero__stat"><dt class="hero__stat-k">Metric 3</dt><dd class="hero__stat-v">32,000</dd></div>
    </dl>
    <p class="hero__note">No spam. Unsubscribe anytime.</p>
    <ul class="hero__trust">
      <li class="hero__trust-item"><img class="hero__trust-img" src="/content/images/trust-1.svg" alt=""><svg class="ico ico--1" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M1 2 L22 3 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="4"></circle><rect x="1" y="4" width="6" height="6" rx="1"></rect></svg></li>
      <li class="hero__trust-item"><img class="hero__trust-img" src="/content/images/trust-2.svg" alt=""><svg class="ico ico--2" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M2 2 L22 4 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="5"></circle><rect x="2" y="4" width="6" height="6" rx="1"></rect></svg></li>
      <li class="hero__trust-item"><img class="hero__trust-img" src="/content/images/trust-3.svg" alt=""><svg class="ico ico--3" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M3 2 L22 5 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="6"></circle><rect x="3" y="4" width="6" height="6" rx="1"></rect></svg></li>
      <li class="hero__trust-item"><img class="hero__trust-img" src="/content/images/trust-4.svg" alt=""><svg class="ico ico--4" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M4 2 L22 6 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="7"></circle><rect x="4" y="4" width="6" height="6" rx="1"></rect></svg></li>
      <li class="hero__trust-item"><img class="hero__trust-img" src="/content/images/trust-5.svg" alt=""><svg class="ico ico--5" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 2 L22 7 L12 22 L2 12 Z"></path><circle cx="12" cy="12" r="3"></circle><rect x="5" y="4" width="6" height="6" rx="1"></rect></svg></li>
    </ul>
  </div>
  <figure class="hero__media">
    {{#if @site.cover_image}}<img class="hero__img" src="{{img_url @site.cover_image size="l"}}" alt="">{{/if}}
    <figcaption class="hero__cap">Photo credit</figcaption>
  </figure>
</section>
