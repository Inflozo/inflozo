{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-tree*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git check-ignore*)",
      "Bash(git shortlog*)",
      "Bash(git blame*)",
      "Bash(git remote -v*)",
      "Bash(git remote get-url*)",
      "Bash(git config --get*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git switch*)",
      "Bash(git checkout main*)",
      "Bash(python3 tools/doc-audit.py*)",
      "Bash(python3 tools/build-board.py*)",
      "Bash(python3 tools/category-prompts.py*)",
      "Bash(python3 tools/tuple-check.py*)",
      "Bash(python3 tools/export-roster.py*)",
      "Bash(python3 tools/inventory-gen.py*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git push --mirror*)",
      "Bash(git push origin --delete*)",
      "Bash(git push origin :*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete*)",
      "Bash(git tag -d*)",
      "Bash(git update-ref*)",
      "Bash(git reflog delete*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git clean*)",
      "Bash(git remote remove*)",
      "Bash(git remote rm*)",
      "Bash(git remote set-url*)",
      "Bash(rm -rf*)"
    ],
    "ask": [
      "Bash(git reset*)",
      "Bash(git revert*)",
      "Bash(git restore*)",
      "Bash(git checkout --*)",
      "Bash(git stash*)",
      "Bash(git merge*)",
      "Bash(git cherry-pick*)"
    ]
  }
}
